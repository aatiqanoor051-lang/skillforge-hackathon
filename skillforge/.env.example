# ==============================================================================
# SkillForge — Environment Configuration Example
# Copy this file to `.env` in the repository root (used by docker-compose)
# and/or into backend/.env and python-service/.env for local (non-docker) runs.
# NEVER commit a real .env file with production secrets.
# ==============================================================================

# ---------- General ----------
NODE_ENV=development

# ---------- MongoDB ----------
MONGO_INITDB_ROOT_USERNAME=skillforge_admin
MONGO_INITDB_ROOT_PASSWORD=change_me_in_production
MONGO_URI=mongodb://skillforge_admin:change_me_in_production@mongo:27017/skillforge?authSource=admin
# When running the backend outside docker-compose, use:
# MONGO_URI=mongodb://localhost:27017/skillforge

# ---------- Backend (Express API Gateway) ----------
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
PYTHON_SERVICE_URL=http://python-service:5001
# When running outside docker-compose:
# PYTHON_SERVICE_URL=http://localhost:5001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20
ENABLE_DEMO_ACCOUNTS=true

# ---------- AI Provider (OpenAI-compatible) ----------
# Leave AI_API_KEY empty to run in graceful fallback / deterministic demo mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1800
AI_TEMPERATURE=0.4

# ---------- Python Analysis Microservice ----------
PY_PORT=5001
PY_CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:5000/api
